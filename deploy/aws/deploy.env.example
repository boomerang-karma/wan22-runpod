# Copy to deploy/aws/deploy.env (git-ignored), fill in, then run deploy/aws/deploy.sh.
# Any of these can also be exported in the shell instead (the shell wins).

AWS_REGION=us-east-1
STACK_NAME=meme-studio              # also names the ECR repo, ECS cluster/service and log groups

# Auth0 "Regular Web Application" (Auth0 dashboard -> Applications -> Create -> Regular Web Applications)
AUTH0_DOMAIN=                       # e.g. dev-abc123.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=                # stored in AWS Secrets Manager, never in the stack; you may export it instead
ALLOWED_EMAILS=                     # optional guest list: "me@x.com,friend@y.com,@mycompany.com"

# Spending guards (estimated RunPod GPU dollars per UTC day)
DAILY_BUDGET_USD=5
USER_DAILY_BUDGET_USD=1
MAX_ACTIVE=3
USER_MAX_ACTIVE=2

# Optional custom domain: the ACM certificate must be in us-east-1. After deploying, CNAME the domain to the
# CloudFrontDomain output.
DOMAIN_NAME=
CERTIFICATE_ARN=

# RunPod: read from config.yaml / .runpod_state.json when empty
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=

# Fargate size (0.5 vCPU / 1 GB is plenty: the GPU work happens on RunPod)
TASK_CPU=512
TASK_MEMORY=1024
